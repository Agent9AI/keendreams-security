{
  "name": "keendreams-security",
  "version": "0.1.0",
  "description": "Open-source, evidence-backed security memory for AI agents and analysts. Runs in your own Cloudflare account.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "overrides": {
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vitest-plugin": "1.1.10",
    "@types/node": "22.20.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
